# ---- সব ভার্সন এখানে ----
NGINX_VERSION=1.28.0
PCRE2_VERSION=10.44
ZLIB_VERSION=1.3.1
QUICTLS_REF=openssl-3.3.0-quic1        # quictls/openssl এর tag; না পেলে repo-র tags দেখে বদলান
PHP_VERSIONS="7.4 8.1 8.2 8.3 8.4"     # প্রতিটির সর্বশেষ patch release php.net থেকে নেওয়া হয়
DEFAULT_PHP=8.3
MYSQL_VERSION=8.4.6
NODE_MAJOR=24
ENABLE_OTEL=1                          # nginx-otel বিল্ড ব্যর্থ হলে শুধু warning, বিল্ড থামবে না
# থার্ড-পার্টি মডিউলের ref (ফাঁকা = default branch). Release-এর আগে tag/commit pin করুন।
LUAJIT_REF=
LUA_NGINX_REF=
NGX_DEVEL_KIT_REF=
BROTLI_REF=
RTMP_REF=
GEOIP2_REF=
NJS_REF=
